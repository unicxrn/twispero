# =============================================================================
# EVO Player - Environment Template
# Copy this file to .env to configure your local environment
# =============================================================================
PS5_HOST=192.168.1.50
PS5_PORT=9021
PS5_MAC=00:11:22:33:44:55
# Linux hosts: your own uid/gid, so files the container writes stay yours
# (run `id -u` and `id -g`). Commented out here on purpose: uncommented with
# the values below, copying this template as-is would override Docker
# Desktop's own default (1001) with this file's 1000. Leave commented out on
# Docker Desktop; uncomment and fill in your own values on Linux.
#HOST_UID=1000
#HOST_GID=1000
