/* =============================================================================
 * EVO PLAYER PRO - Playback HUD & OSD Stylesheet (RCSS)
 * Premium PlayStation Obsidian & Sapphire Blue Theme
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16dp;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Top Gradient Scrim */
#top-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920dp;
    height: 150dp;
    padding: 36dp 60dp 0 60dp;
    background-color: #06080de8;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    overflow: hidden;
}

/*
 * Fixed-width clip window for the title + metadata (#16): 1920 - 120 padding
 * - room for the quality badge. A long title/metadata line is clipped here
 * instead of pushing the badge off the right edge, and the C++ marquee tick
 * slides #media-title left inside this window to reveal the tail (#44),
 * matching the legacy evo_text_marquee ping-pong.
 */
#title-block {
    display: block;
    width: 1500dp;
    height: 78dp;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
}

#media-title {
    font-size: 34dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5dp;
    white-space: nowrap;
}

#media-meta {
    font-size: 15dp;
    color: #a2b0c2;
    font-weight: bold;
    letter-spacing: 0.5dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 1500dp;
    margin-top: 6dp;
}

#badge-rack {
    display: flex;
    flex-direction: row;
    gap: 12dp;
    align-items: center;
    margin-top: 6dp;
    flex-shrink: 0;
}

/* The Twitch quality playing ("1080p60"); hidden when there is none. */
.badge-quality {
    display: none;
    background-color: #000000a0;
    border-width: 1dp;
    border-color: #ffffff55;
    color: #ffffff;
    font-weight: bold;
    font-size: 15dp;
    padding: 5dp 12dp;
    border-radius: 8dp;
    letter-spacing: 0.5dp;
}

/* No picture (Twitch's "Audio only"): the channel on a card in the middle. */
#music-view {
    display: none;
    position: absolute;
    left: 560dp;
    top: 380dp;
    width: 800dp;
    height: 200dp;
    flex-direction: column;
}

#music-card {
    width: 800dp;
    height: 200dp;
    background-color: #18181be6;
    border-width: 1dp;
    border-color: #9146ff80;
    border-radius: 28dp;
    padding: 40dp;
    display: flex;
    flex-direction: row;
    align-items: center;
}

#music-art {
    width: 112dp;
    height: 112dp;
    background-color: #9146ff;
    border-radius: 56dp;
    margin-right: 36dp;
    flex-shrink: 0;
}

#music-lines {
    display: flex;
    flex-direction: column;
    width: 560dp;
    overflow: hidden;
}

#music-title {
    font-size: 30dp;
    font-weight: bold;
    color: #efeff1;
    letter-spacing: 0.5dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#music-state {
    font-size: 18dp;
    font-weight: bold;
    color: #bf94ff;
    letter-spacing: 1.5dp;
    margin-top: 14dp;
}

/* Center Scrubbing & Pause Overlay */
#center-overlay {
    position: absolute;
    top: 440dp;
    left: 710dp;
    width: 500dp;
    height: 140dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12dp;
}

#scrub-capsule {
    display: none;
    background-color: #0c1018f2;
    border-width: 2dp;
    border-color: #00d2ff;
    border-radius: 20dp;
    padding: 12dp 16dp;
    flex-direction: column;
    align-items: center;
    gap: 10dp;
}

/*
 * Scrub preview. Hidden until prospero_thumbnail has decoded a frame for the
 * position under the play head, so the capsule keeps its old pill shape while
 * the first preview is still being fetched and grows into it once it lands
 * rather than reserving an empty box up front.
 *
 * 320x180 is PROSPERO_THUMB_W/H exactly - the cache decodes at that size, so
 * drawing it 1:1 is a straight blit with no resample.
 */
#scrub-thumb {
    display: none;
    width: 320dp;
    height: 180dp;
    border-radius: 12dp;
}

#scrub-readout {
    flex-direction: row;
    align-items: center;
    gap: 14dp;
    padding: 0dp 12dp;
}

#scrub-label {
    font-size: 15dp;
    font-weight: bold;
    color: #00d2ff;
    letter-spacing: 1.5dp;
}

#scrub-time {
    font-size: 24dp;
    font-weight: bold;
    color: #ffffff;
}

#pause-badge {
    display: none;
    background-color: #0070d1e6;
    border-width: 1dp;
    border-color: #38bdf8;
    border-radius: 12dp;
    padding: 10dp 26dp;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
}

#pause-label {
    font-size: 20dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2dp;
}

/* Dev FPS pill (#81) — top-right, independent of the OSD chrome */
#fps-pill {
    display: none;
    position: absolute;
    top: 12dp;
    right: 12dp;
    background-color: #000000aa;
    border-radius: 6dp;
    padding: 4dp 10dp;
    z-index: 8;
}

#fps-value {
    font-size: 15dp;
    font-weight: bold;
    color: #f8fafc;
    letter-spacing: 0.5dp;
}

/* Playback diagnostic HUD (#81 / #63) */
#stats-hud {
    display: none;
    position: absolute;
    top: 150dp;
    left: 60dp;
    width: 560dp;
    background-color: #080c14f2;
    border-width: 1dp;
    border-color: #1e2838;
    border-radius: 14dp;
    padding: 16dp 20dp;
    flex-direction: column;
    gap: 6dp;
}

.stats-title {
    font-size: 13dp;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 1dp;
    border-bottom-width: 1dp;
    border-bottom-color: #1a2332;
    padding-bottom: 6dp;
}

.stats-line {
    font-size: 13dp;
    font-weight: bold;
    color: #d4dde8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stats-sep {
    height: 1dp;
    background-color: #1a2332;
    margin-top: 4dp;
    margin-bottom: 2dp;
}

.graph-row {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 10dp;
    height: 40dp;
}

.graph-label {
    font-size: 12dp;
    font-weight: bold;
    width: 38dp;
    flex-shrink: 0;
}

.graph {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 36dp;
    width: 400dp;
    background-color: #0c121c;
    border-radius: 4dp;
    padding: 2dp;
    flex-shrink: 0;
}

.graph-bar {
    width: 6dp;
    margin-right: 1dp;
    min-height: 1dp;
    background-color: #38506e;
}

.graph-val {
    font-size: 12dp;
    font-weight: bold;
    width: 58dp;
    flex-shrink: 0;
    text-align: right;
}

.text-green { color: #00ffaa; }
.text-cyan  { color: #00d2ff; }
.text-amber { color: #ffb020; }

/* Bottom Controller Console */
#bottom-scrim {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1920dp;
    height: 190dp;
    padding: 24dp 60dp 28dp 60dp;
    background-color: #06080df5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
}

/* Timeline (not live) */
#progress-container {
    width: 1800dp;
    height: 24dp;
    display: flex;
    align-items: center;
    margin-bottom: 6dp;
}

#progress-track {
    width: 1800dp;
    height: 8dp;
    background-color: #1d293d;
    border-radius: 4dp;
    position: relative;
}

#progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 8dp;
    background-color: #0070d1;
    border-radius: 4dp;
}

#progress-thumb {
    position: absolute;
    right: -8dp;
    top: -5dp;
    width: 18dp;
    height: 18dp;
    border-radius: 9dp;
    background-color: #ffffff;
    border-width: 3dp;
    border-color: #0070d1;
}

/* Time Row */
#time-row {
    width: 1800dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14dp;
}

#time-current {
    font-size: 16dp;
    font-weight: bold;
    color: #ffffff;
}

#time-duration {
    font-size: 16dp;
    font-weight: bold;
    color: #a2b0c2;
}

/* Bottom Action Ribbon & Hints */
#controls-row {
    width: 1800dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 28dp;
}

.control-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.btn-icon {
    width: 22dp;
    height: 22dp;
    display: inline-block;
}

.glyph-badge {
    width: 30dp;
    height: 30dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15dp;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 20dp;
    height: 20dp;
}

.btn-tag {
    background-color: #1a2336;
    border-width: 1dp;
    border-color: #2e3e5c;
    padding: 2dp 7dp;
    border-radius: 7dp;
    font-size: 11dp;
    font-weight: bold;
    color: #00d2ff;
}

.control-label {
    font-size: 14dp;
    color: #e2e8f0;
    font-weight: bold;
    letter-spacing: 0.5dp;
}

/* LOADING: a seek, or the first frames, on the way (network streams can take
 * seconds). Same place and shape as the PAUSED badge, with a spinner. */
#loading-badge {
    display: none;
    background-color: #0b1220e6;
    border-width: 1dp;
    border-color: #38bdf8;
    border-radius: 12dp;
    padding: 12dp 26dp;
    flex-direction: row;
    align-items: center;
    gap: 14dp;
}

#loading-spinner {
    display: inline-block;
    width: 26dp;
    height: 26dp;
    border-radius: 13dp;
    border-width: 3dp;
    border-color: #00cdff33;
    border-top-color: #00cdff;
    animation: 0.8s linear infinite pb-spin;
}

#loading-label {
    font-size: 20dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2dp;
}

@keyframes pb-spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}
